setcpm(120/4)
const KEY = "A:minor"

$SYNTH: n("<0 [-1 -2]>".padEnd("[0@7 <[0,7] 0>]"))
    .scale(KEY)
    .struct("[x@2 x x@2 x x@2 ] x*4")
    .s("supersaw")
    .distor(0,3)
    .legato("[0,4@3 0.9] !2")
    .lpf("[3000@3 1200] !2")
    .delay(0.05)
    .pan("0.2, 0.8")
    .decay("0.3, 0.4")
    .gain(slider("gain", 0.5, 0, 1))

$KICK: s("bd*4")
    .bank("compurhythm1000")
    .room(".5")

$SNARE: s("[~sd]*2")
    .bank("compurhythm1000")
    .room(".5")